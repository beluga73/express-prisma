generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

generator zod {
  provider         = "zod-prisma-types"
  output           = "../src/generated/zod"
  useMultipleFiles = false // Bundles everything into one file for easy importing
  prismaClientPath = "@/generated/prisma"
}

model Tasks {
  id       Int    @id @default(autoincrement())
  title    String
  position String
  columnId Int
  column   Column @relation(fields: [columnId], references: [id], onDelete: Cascade)
}

model Column {
  id       Int     @id @default(autoincrement())
  title    String
  position Int
  tasks    Tasks[]
}
