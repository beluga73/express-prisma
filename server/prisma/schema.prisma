generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tasks {
  id       Int    @id @default(autoincrement())
  title    String
  position Int
  columnId Int
  column   Column @relation(fields: [columnId], references: [id], onDelete: Cascade)
}

model Column {
  id       Int     @id @default(autoincrement())
  title    String
  position Int
  tasks    Tasks[]
}
