generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

generator zod {
  provider         = "zod-prisma-types"
  output           = "../src/generated/zod"
  useMultipleFiles = false // Bundles everything into one file for easy importing
  prismaClientPath = "@/generated/prisma"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  refreshToken String?
  columns      Column[]

  @@map("users")
}

model Column {
  id       Int    @id @default(autoincrement())
  title    String
  position Int
  tasks    Task[]
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String

  @@map("columns")
}

model Task {
  id       Int    @id @default(autoincrement())
  title    String
  position String
  columnId Int
  column   Column @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@map("tasks")
}
